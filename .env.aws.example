# ============================================================
# FinSight 360 — AWS / data-lake configuration
# ============================================================
# Copy to `.env` (or merge into your existing .env) and adjust.
#
# LOCAL ($0) MODE  -> set AWS_ENDPOINT_URL to the LocalStack URL.
# REAL AWS MODE    -> leave AWS_ENDPOINT_URL blank and use real
#                     credentials + a real Redshift endpoint.
# ------------------------------------------------------------

# --- Mode switch ---------------------------------------------
# Point the SDK at LocalStack for free local runs. Leave EMPTY
# (comment it out) to talk to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Data lake ------------------------------------------------
# Single lake bucket with bronze/silver/gold zone prefixes.
LAKE_BUCKET=finsight-360-datalake
BRONZE_PREFIX=bronze
SILVER_PREFIX=silver
GOLD_PREFIX=gold

# --- Redshift (or local Postgres standing in for Redshift) ----
# LOCAL: the docker-compose Postgres acts as the warehouse.
# REAL : your Redshift Serverless endpoint + workgroup.
REDSHIFT_HOST=localhost
REDSHIFT_PORT=5439
REDSHIFT_DB=customer360
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=admin
REDSHIFT_SCHEMA=customer360

# IAM role Redshift assumes to COPY from S3 (real AWS only).
# On LocalStack this is ignored.
REDSHIFT_IAM_ROLE=arn:aws:iam::000000000000:role/finsight-redshift-copy-role
